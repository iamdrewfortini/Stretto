# Stretto runtime settings. Copy this file to ".env" in the folder you start Stretto from, or to "<data folder>/.env".
# Never commit ".env". Real environment variables override this file.

# --- Meta Model API (required for AI coaching) -------------------------------------------------------------
# Create a key at https://dev.meta.ai (Meta Model API) and paste it after the = sign. Judges: use your own key.
MODEL_API_KEY=

# --- Keyless mode (no key, no network): answer from recorded Meta replies instead of calling the API ---------
# STRETTO_REPLAY=samples/recorded

# --- Record live Meta replies so someone else can replay them (needs MODEL_API_KEY) ---------------------------
# STRETTO_RECORD=samples/recorded

# --- Optional ---------------------------------------------------------------------------------------------
# STRETTO_ENV_FILE=/path/to/another.env     use this file instead of ./.env
