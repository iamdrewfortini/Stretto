# ENV-STANDARD-01 · Meta Coherence runtime environment
# Copy to .env (gitignored, mode 600). Load with: scripts/with_env.sh <command>
# Check with: python3 scripts/env_check.py   (exits non-zero on any failure)
# Secrets: never commit a value. Each secret names its 1Password source with `# op:`.

# --- runtime boundary (local only) ---
RUNTIME_MODE=local                     # only "local" is accepted
GATEWAY_BIND=127.0.0.1:8787            # loopback only; the gateway refuses any other interface
VOICE_BIND=127.0.0.1:8788              # voice websocket; loopback only
STRETTO_URL=http://127.0.0.1:8760       # the Stretto server the gateway fronts; loopback only
EGRESS_ALLOWLIST=api.meta.ai           # comma-separated hosts the gateway may call; nothing else
REGISTRY_PATH=docs/spec/models.registry.json
EVENT_LOG=var/events.jsonl
LEDGER_PATH=var/ledger.jsonl

# --- Meta Model API ---
META_BASE_URL=https://api.meta.ai/v1
META_ASR_URL=wss://api.meta.ai/v1/asr/realtime
MODEL_API_KEY=                         # op://tqppe4pcdltsilo6drbzbtnavy/rplv2wen3g32pucg7jmegxoay4/credential  (item "Meta_Postiz_API")

# --- voice core / agents ---
VOICE_MODEL_ROLE=voice.core
OWNER_ID=owner                         # the one person whose ledger this is
VOICE_EFFORT=low
ALLOW_CONTRIBUTOR=1
SPEND_LIMIT_USD=5.00                   # cost guard trips background agents past this
